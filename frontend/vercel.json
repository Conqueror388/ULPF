{
  rewrites: [
    {
      source: /api/:path*,
      destination: https://ulpf-gvpx.onrender.com/api/:path*
    },
    {
      source: /docs,
      destination: https://ulpf-gvpx.onrender.com/docs
    },
    {
      source: /openapi.json,
      destination: https://ulpf-gvpx.onrender.com/openapi.json
    },
    {
      source: /(.*),
      destination: /index.html
    }
  ]
}
